# Copy to .env (git-ignored) and fill in. Never commit .env.
# Base URL of Home Assistant on your LAN (homeassistant.local:8123, or the VM's IP).
HA_BASE_URL=http://homeassistant.local:8123
# Unique, random webhook ID used in the HA automation. Generate with:
#   python tools/test_announcement.py --generate-id
HA_WEBHOOK_ID=
